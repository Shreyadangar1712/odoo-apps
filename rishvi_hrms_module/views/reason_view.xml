<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_reason_list" model="ir.ui.view">
        <field name="name">hr.reason.list</field>
        <field name="model">hr.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_reason_form" model="ir.ui.view">
        <field name="name">hr.reason.form</field>
        <field name="model">hr.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_reason" model="ir.actions.act_window">
        <field name="name">Reasons</field>
        <field name="res_model">hr.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_reason"
              name="Reasons"
              parent="menu_hr_shift_root"
              action="action_hr_reason"
              sequence="10"/>
</odoo>
