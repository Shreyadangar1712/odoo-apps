<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_shift_form" model="ir.ui.view">
        <field name="name">hr.shift.form</field>
        <field name="model">hr.shift</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="grace_time"/>
                        </group>
                        <group>
                            <field name="start_time_display" placeholder="09:00 AM"/>
                            <field name="end_time_display" placeholder="05:00 PM"/>
                            <!-- <field name="is_night_shift"/> -->
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_hr_shift_tree" model="ir.ui.view">
        <field name="name">hr.shift.tree</field>
        <field name="model">hr.shift</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="start_time_display"/>
                <field name="end_time_display"/>
                <field name="grace_time"/>
                <!-- <field name="is_night_shift" widget="boolean_toggle"/> -->
            </list>
        </field>
    </record>

    <record id="action_hr_shift" model="ir.actions.act_window">
        <field name="name">Shifts</field>
        <field name="res_model">hr.shift</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_shift_root"
              name="Shifts"
              parent="hr_attendance.menu_hr_attendance_root"
              sequence="5"/>

    <menuitem id="menu_hr_shift"
              name="Manage Shifts"
              parent="menu_hr_shift_root"
              action="action_hr_shift"/>

</odoo>
