<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_payslip_form_attendance_hours" model="ir.ui.view">
        <field name="name">hr.payslip.form.attendance.hours</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="attendance_worked_hours" string="Attendance Hours" readonly="1" widget="float_time"/>
                <field name="attendance_extra_hours" string="Attendance Extra Hours" readonly="1" widget="float_time"/>
            </xpath>
        </field>
    </record>

</odoo>   
