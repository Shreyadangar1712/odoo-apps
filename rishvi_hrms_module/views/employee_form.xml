<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_employee_form_inherit_policy" model="ir.ui.view">
        <field name="name">hr.employee.form.policy</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group" position="inside">
                <field name="attendance_policy"/>
                <field name="attendance_shift"/>
                <field name="allow_overtime"/>
                <field name="reason_required"/>
            </xpath>
        </field>
    </record>

</odoo>
