<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="absent_reminder_email_template" model="mail.template">
            <field name="name">Monthly Absent Reminder</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">&#x23F0; Monthly Absence Reminder – {{ ctx.get('absence_month', '') }} {{ ctx.get('absence_year', '') }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="email_to">{{ object.work_email }}</field>
            <field name="email_from">{{ user.email_formatted or object.company_id.email or '' }}</field>
            <field name="description">Monthly absence reminder sent by HR to employees.</field>
            <field name="body_html" type="html">
<div style="margin:0;padding:0;background-color:#f4f6f9;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;">
  <table width="100%" cellspacing="0" cellpadding="0" style="background-color:#f4f6f9;padding:24px 0;">
    <tr>
      <td align="center">
        <table width="600" cellspacing="0" cellpadding="0"
               style="background-color:#ffffff;border-radius:10px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,0.09);">
          <tr>
            <td align="center" style="background:linear-gradient(135deg,#2c3e50 0%,#3498db 100%);padding:36px 24px;">
              <h1 style="color:#ffffff;margin:0;font-size:22px;letter-spacing:1px;">Monthly Absence Reminder</h1>
              <p style="color:#d0e8f7;margin:8px 0 0 0;font-size:15px;">
                <t t-out="env.context.get('absence_month', '')"/> <t t-out="env.context.get('absence_year', '')"/>
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:32px 36px;">
              <p style="color:#2c3e50;font-size:16px;margin:0 0 16px 0;">
                Dear <strong><t t-out="object.name"/></strong>,
              </p>
              <p style="color:#555;font-size:15px;line-height:1.7;margin:0 0 20px 0;">
                This is a friendly reminder from the HR team regarding your attendance for
                <strong><t t-out="env.context.get('absence_month', '')"/> <t t-out="env.context.get('absence_year', '')"/></strong>.
              </p>
              <table width="100%" cellspacing="0" cellpadding="0"
                     style="background-color:#fef9f9;border-left:4px solid #e74c3c;border-radius:4px;margin-bottom:24px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <span style="display:block;color:#7f8c8d;font-size:13px;text-transform:uppercase;letter-spacing:0.5px;">Total Absent Days in <t t-out="env.context.get('absence_month', '')"/></span>
                    <strong style="display:block;color:#c0392b;font-size:24px;margin-top:4px;">
                      <t t-out="env.context.get('absence_days', 0)"/> day(s)
                    </strong>
                  </td>
                </tr>
              </table>
              <t t-if="env.context.get('absence_days', 0) > 0">
                <p style="color:#e67e22;font-size:14px;line-height:1.6;margin:0;padding:12px;background:#fff8e1;border-radius:6px;">
                  <i class="fa fa-info-circle"/> If you believe this is incorrect or have supporting documents, please contact the HR department at your earliest convenience.
                </p>
                <t t-if="env.context.get('absence_dates')">
                  <p style="color:#2c3e50;font-size:14px;font-weight:bold;margin:20px 0 8px 0;">Breakdown of Absent Dates:</p>
                  <ul style="color:#555;font-size:14px;margin:0;padding-left:20px;line-height:1.6;">
                    <t t-foreach="env.context.get('absence_dates')" t-as="date_str">
                      <li><t t-out="date_str"/></li>
                    </t>
                  </ul>
                </t>
              </t>
              <t t-else="">
                <p style="color:#27ae60;font-size:14px;line-height:1.6;margin:0;padding:12px;background:#e9f7ef;border-radius:6px;">
                  Great job! You had no absences in <t t-out="env.context.get('absence_month', '')"/>. Keep up the excellent attendance!
                </p>
              </t>
            </td>
          </tr>
          <tr>
            <td style="background-color:#f4f6f9;padding:24px 36px;border-top:1px solid #e8e8e8;text-align:center;">
              <p style="color:#7f8c8d;font-size:14px;margin:0 0 4px 0;">Regards,</p>
              <p style="color:#2c3e50;font-size:14px;font-weight:bold;margin:0;">
                <t t-out="object.company_id.name"/> – HR Team
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</div>
            </field>
            <field name="lang">{{ object.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

        <record id="ir_cron_monthly_absence_reminder" model="ir.cron">
            <field name="name">Attendance: Monthly Absence Reminder Email</field>
            <field name="model_id" ref="base.model_res_config_settings"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_monthly_absence_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
