<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_auto_check_out_single_punch" model="ir.cron">
        <field name="name">Auto Check-Out Single Punch Attendances</field>
        <field name="model_id" search="[('model','=','hr.attendance')]"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_check_out_single_punch()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="ir_cron_attendance_report_mail_queue" model="ir.cron">
        <field name="name">Attendance Report Mail Queue</field>
        <field name="model_id" search="[('model','=','hr.attendance.manager.monthly.mail.job')]"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_mail_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
