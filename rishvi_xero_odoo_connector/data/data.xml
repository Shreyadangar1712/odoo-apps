<odoo>
    <data>

        <!-- Sales Orders -->
        <record id="collection_sale_order" model="quick.book.collection">
            <field name="name">Sale Order</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="field_domain">[('xero_sale_id', '>', 0)]</field>
        </record>

        <!-- Purchase Orders -->
        <record id="collection_purchase_order" model="quick.book.collection">
            <field name="name">Purchase Order</field>
            <field name="model_id" ref="model_purchase_order"/>
            <field name="field_domain">[('xero_purchase_id', '>', 0)]</field>
        </record>

        <!-- Customer Invoices -->
        <record id="collection_customer_invoice" model="quick.book.collection">
            <field name="name">Invoices</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="field_domain">
                [('xero_invoice_id', '>', 0), ('move_type', '=', 'out_invoice')]
            </field>
        </record>

        <!-- Vendor Bills -->
        <record id="collection_vendor_bill" model="quick.book.collection">
            <field name="name">Bills</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="field_domain">
                [('xero_invoice_id', '>', 0), ('move_type', '=', 'in_invoice')]
            </field>
        </record>

