<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="tally_configuration_form">
            <field name="name">Configuration</field>
            <field name="model">res.configuration</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Tally Configuration">
                    <sheet>
                        <div class="oe_button_box" name="button_box"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"  invisible="active"/>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                            <field name="active" invisible="1"/>
                        </div>
                        <group>
                            <group string="Ledger Configuration">
                                <field name="acc_journal_ledger"/>
                                <field name="acc_category_ledger"/>
                                <field name="acc_tax_ledger"/>
                            </group>
                            <group string="GST OVR DN NATURE">
                                <field name="gst_ovr_dn_nature_local"/>
                                <field name="gst_ovr_dn_nature_interstate"/>
                                <field name="gst_ovr_dn_nature_overseas"/>
                            </group>
                            <group string="Other Configuration">
                                <field name="ledger_by" widget="radio"/>
                                <field name="bill_allocation"/>
                                <field name="field_mapping_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="tally_configuration_tree">
            <field name="name">Configuration</field>
            <field name="model">res.configuration</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Tally Configuration">
                    <field name="name" />
                    <field name="ledger_by" />
                    <field name="bill_allocation" />
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="create_uid"/>
                    <field name="create_date"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="tally_configuration_action">
            <field name="name">Configuration</field>
            <field name="res_model">res.configuration</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="tally_configuration_tree" />
        </record>

        <menuitem id="account_tally_configuration" name="Tally" parent="account.menu_finance" sequence="21"/>
        <menuitem id="tally_configuration_menu"  name="Configuration" parent="account_tally_configuration" action="tally_configuration_action" sequence="2"/>

    </data>
</odoo>
