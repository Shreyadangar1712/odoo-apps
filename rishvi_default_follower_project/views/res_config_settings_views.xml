<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.project</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="50"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//app/block[@id='tasks_management']" position="before">
                    <app data-string="Project" string="Project" name="project" groups="project.group_project_manager">
                        <block title="Project Management" id="projects_management">
                            <setting id="default_followers" help="Set default user in Project.">
                                <field name="partner_ids"  widget="many2many_tags"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
</odoo>
