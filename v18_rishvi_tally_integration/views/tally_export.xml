<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="export_xml_filter" model="ir.ui.view">
            <field name="name">tally.export.invoice.Filter</field>
            <field name="model">tally.export.invoice</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="state"/>
                    <separator/>
                    <filter string="Draft" domain="[('state', '=', 'draft')]" name="draft"/>
                    <filter string="In Progress" domain="[('state', '=', 'in_progress')]" name="in_progress"/>
                    <filter string="Done" domain="[('state', '=', 'done')]" name="done"/>
                    <filter string="Failed" domain="[('state', '=', 'failed')]" name="failed"/>
                    <separator/>
                    <group string="Group By...">
                        <filter string="Status" context="{'group_by': 'state'}" name="group_by_state"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_export_xml_tree" model="ir.ui.view">
            <field name="name">tally.export.invoice.tree</field>
            <field name="model">tally.export.invoice</field>
            <field name="arch" type="xml">
                <list string="Generate XML" decoration-bf="state == 'draft'" decoration-danger="state == 'cancel'" decoration-info="state in ('in_progress')" decoration-success="state == 'done'">
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="create_uid"/>
                    <field name="write_date"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- model.name tree view -->
        <record id="view_account_invoice_line_tree" model="ir.ui.view">
            <field name="name">account.move.view.tree</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <list default_order="name asc,invoice_date asc">
                    <field name="name" decoration-bf="1"/>
                    <field name="partner_id"/>
                    <field name="invoice_date"   string="Invoice Date"/>
                    <field name="invoice_user_id" optional="show" string="Sales Person" widget="many2one_avatar_user"/>
                    <field name="ref" optional="show" />
                    <field name="amount_total" sum="Total" string="Actual Total"/>
                    <field name="amount_untaxed_signed" string="Tax Excluded" sum="Total" optional="show"/>
                    <field name="amount_total_signed" string="Total" sum="Total" decoration-bf="1" optional="show"/>
                    <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'" optional="show"/>
                    <field name="payment_state" widget="badge" decoration-danger="payment_state == 'not_paid'" decoration-warning="payment_state in ('partial', 'in_payment')" decoration-success="payment_state in ('paid', 'reversed')" invisible="payment_state in ('invoicing_legacy')"/>
                    <field name="move_type" invisible="context.get('default_move_type', True)"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_export_xml_form" model="ir.ui.view">
            <field name="name">tally.export.invoice.form</field>
            <field name="model">tally.export.invoice</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <form string="Generate XML">
                    <header>
                        <button name="in_queue" string="Proceed" class="oe_highlight" invisible="state not in ('draft')" type="object"/>
                        <button name="validate" string="Generate XML" class="oe_highlight" type="object" invisible="state  in ('draft','in_progress') and attachment_fname" />
                        <button name="validate" string="Forcefully Generate XML" class="oe_highlight" type="object" invisible="state  in ('draft','in_progress') and not attachment_fname" />
                        <button name="set_to_done" string="Mark Done" class="oe_highlight" type="object" invisible="state not in ('in_progress') or not attachment_fname"/>
                        <button name="set_to_draft" string="Set To Draft" class="oe_highlight" invisible="state not in ('failed')" type="object"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                            <field name="id" invisible="1"/>
                        </div>
                        <group>
                            <group>
                                <field name="attachment_datas" filename="attachment_fname"/>
                                <field name="attachment_fname" invisible="1"/>
                            </group>
                            <group>
                                <field name="configuration_id" />
                                <field name="create_date" readonly="1"/>
                                <field name="create_uid" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="invoices" string="Invoices">
                                <div>
                                    <b><label for="date_from" string="Invoice Date From"/></b> 
                                    <field name="date_from" class="oe_inline" nolabel="1" readonly="state in ('in_progress', 'done')"  required="1"/> - 
                                    <b><label for="date_to" string=" To"/></b> 
                                    <field name="date_to" class="oe_inline" nolabel="1" readonly="state in ('in_progress', 'done')"  required="1"/>
                                </div>
                                <field name="invoice_ids" readonly="state in ('in_progress', 'done')" domain="[('invoice_date','&gt;=',date_from),('invoice_date','&lt;=',date_to),('payment_state','=','paid'),('move_type', '=', 'out_invoice')]" context="{'tree_view_ref':'tally_odoo_connector.view_account_invoice_line_tree'}">
                                </field>
                            </page>
                        </notebook>
                        <label for="comment"/>
                        <field name="comment" readonly="1" widget="html" class="text-danger"/>
                    </sheet>
                    <div class="oe_chatter" invisible="not id" >
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_export_tally_xml" model="ir.actions.act_window">
            <field name="name">Generate XML</field>
            <field name="res_model">tally.export.invoice</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_export_xml_tree"/>
        </record>

        <menuitem name="Tally Invoices" id="menu_tally" parent="account.menu_finance"/>

        <menuitem name="Generate XML" id="menu_export_tally_xml" parent="menu_tally" action="action_export_tally_xml"/>
    </data>
</odoo>
