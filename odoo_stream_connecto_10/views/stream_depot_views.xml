<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_stream_depot_tree" model="ir.ui.view">
        <field name="name">stream.depot.tree</field>
        <field name="model">stream.depot</field>
        <field name="arch" type="xml">
            <list>
                <field name="external_id"/>
                <field name="name"/>
                <field name="city"/>
                <field name="country"/>
                <field name="contact_name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_stream_depot_form" model="ir.ui.view">
        <field name="name">stream.depot.form</field>
        <field name="model">stream.depot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="external_id"/>
                        <field name="name"/>

                        <separator string="Address"/>

                        <field name="address1"/>
                        <field name="address2"/>
                        <field name="address3"/>
                        <field name="city"/>
                        <field name="state"/>
                        <field name="country"/>
                        <field name="postcode"/>
                        <field name="latitude"/>
                        <field name="longitude"/>

                        <separator string="Contact"/>

                        <field name="contact_name"/>
                        <field name="phone"/>
                        <field name="phone2"/>
                        <field name="mobile"/>
                        <field name="email"/>

                        <separator string="Stock Location"/>

                        <field name="stock_location_id"/>
                        <field name="stock_location_name"/>

                        <separator string="Delivery Methods"/>

                      
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_stream_depot" model="ir.actions.act_window">
        <field name="name">Depot</field>
        <field name="res_model">stream.depot</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_stream_menu_root"
        name="Stream"
        parent="sale.sale_menu_root"
        sequence="100"/>
    <menuitem
        id="menu_stream_depot"
        name="Stream Depot"
        parent="menu_stream_menu_root"
        action="action_stream_depot"
        sequence="100"/>

    <!-- Run Details Menu -->
    <menuitem
        id="menu_stream_run_details"
        name="Run Details"
        parent="menu_stream_menu_root"
        action="action_stream_run_details"
        sequence="110"/>


     

</odoo>