<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="delivery_carrier_form_inherit_stream_delivery"
            model="ir.ui.view">

        <field name="name">
            delivery.carrier.form.inherit.stream.delivery
        </field>

        <field name="model">delivery.carrier</field>

        <field name="inherit_id"
               ref="delivery.view_delivery_carrier_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='tracking_url']"
                   position="after">

                <field name="steam_delivery"/>

            </xpath>

        </field>

    </record>

</odoo>