<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="rishvi_sale_order_form_view" model="ir.ui.view">
        <field name="name">sale.order.form.rishvi</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
			    <field name="to_delivery_qty" invisible="not split_stock_purchase"  readonly="1" optional="hide"/>
    			<field name="to_dropship_qty" invisible="not split_stock_purchase" readonly="1" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
