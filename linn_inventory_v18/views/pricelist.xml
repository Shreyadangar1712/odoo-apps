<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_pricelists_form" model="ir.ui.view">
        <field name="name">product.pricelists.form.inherit</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
    </record>
    <record id="view_product_pricelists_list" model="ir.ui.view">
        <field name="name">product.picelists.list.inherit</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view_tree"/>

    </record>

     <record id="action_pricelist_list" model="ir.actions.act_window">
            <field name="name">Pricelists</field>
            <field name="path">inventory_pricelists</field>
            <field name="res_model">product.pricelist</field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem id="menu_price_list"
                name="PriceList"
                sequence="12"
                parent="menu_product_dashboard_root"
                action="action_pricelist_list"/>
</odoo>