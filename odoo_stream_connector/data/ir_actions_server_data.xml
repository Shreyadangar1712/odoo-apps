<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="action_export_sale_order_to_stream"
            model="ir.actions.server">
        <field name="name">
            Export Sale Orders to Stream
        </field>
        <field name="model_id"
               ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">
        action = records.action_export_to_stream()
        </field>

    </record>

     <!-- Bulk Export Sale Orders to Xero -->

    <record id="action_bulk_export_sale_orders_to_stream"
            model="ir.actions.server">
        <field name="name">Export  Sale Orders to stream</field>

        <field name="model_id" ref="sale.model_sale_order"/>

        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">action</field>

        <field name="state">code</field>

        <field name="code">

if records:
    records.action_export_to_stream()

        </field>

    </record>


</odoo>