<odoo>
<record id="ir_cron_export_sale_orders_to_stream" model="ir.cron">
    <field name="name">Export Sale Orders To Stream</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="state">code</field>
    <field name="code">model.cron_export_sale_orders_to_stream()</field>
    <field name="interval_number">30</field>
    <field name="interval_type">minutes</field>
    <field name="active">True</field>
</record>
<record id="ir_cron_sync_stream_order_status" model="ir.cron">
    <field name="name">Sync Stream Order Status</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="state">code</field>
    <field name="code">model.cron_sync_stream_order_status()</field>
    <field name="interval_number">5</field>
    <field name="interval_type">minutes</field>
    <field name="active">True</field>
</record>

<record id="ir_cron_stream_run_details_sync" model="ir.cron">
    <field name="name">Sync Stream Run Details</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="state">code</field>
    <field name="code">model.cron_sync_stream_run_details()</field>
    <field name="interval_number">5</field>
    <field name="interval_type">minutes</field>
    <field name="active">True</field>
</record>
</odoo>