<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_stream_connector" model="ir.ui.view">
        <field name="name">sale.order.form.stream.connector</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">

                <button name="action_export_to_stream"
                type="object"
                string="Export --> Stream"
                class="btn-primary" invisible="stream_exported"/>

                <button
    name="action_sync_run_details"
    string="Sync Run Details"
    type="object"
    class="btn-primary" invisible="not stream_exported"
/>
            </xpath>
            <xpath expr="//group" position="inside">
                <group>
                    <field name="order_type" readonly="stream_exported"/>
                    <field name="stream_services" widget="many2many_tags" options="{'no_create': True}" readonly="stream_exported" />
                    <field name="booking_required" widget="boolean_toggle" readonly="stream_exported"/>
                    <field name="update_addresses" readonly="stream_exported"/> 
                    <field name="stream_status"/>    
                    
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
            <page string="Stream">
                <group>
                    <field name="stream_exported" readonly="1"/>
                     <field name="stream_consignment_no"/>
                    <field name="stream_tracking_id"/>
                    <field name="stream_tracking_url" widget="url"/>
                      <field name="run_detail_ids" readonly="1">

                            <list>
                                <field name="stream_run_id"/>
                                <field name="description"/>
                                <field name="vehicle"/>
                                <field name="driver_name"/>
                                <field name="dispatched"/>
                                <field name="departed"/>
                                <field name="completed"/>
                            </list>

    </field>
    
                </group>
            </page>
           
        </xpath>
        <xpath expr="//notebook" position="inside">
            <page string="Delivery">
                 <group>
                    <field name="carrier_id"/>
                </group>
            </page>
        </xpath>
        </field>
    </record>


   

  <record id="view_sale_order_list_stream_connector" model="ir.ui.view">
    <field name="name">sale.order.list.stream.connector</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.sale_order_list_upload"/>
    <field name="arch" type="xml">

        <xpath expr="//field[@name='partner_id']" position="after">
                        <field name="stream_consignment_no"/>

        </xpath>

    </field>
</record>


    
</odoo>