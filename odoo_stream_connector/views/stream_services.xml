<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_stream_service_tree" model="ir.ui.view">
        <field name="name">stream.service.tree</field>
        <field name="model">stream.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_stream_service_form" model="ir.ui.view">
        <field name="name">stream.service.form</field>
        <field name="model">stream.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_stream_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">stream.service</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_stream_service"
        name="Stream Services"
        parent="menu_stream_menu_root"
        action="action_stream_service"
         sequence="101"/>

   

</odoo>