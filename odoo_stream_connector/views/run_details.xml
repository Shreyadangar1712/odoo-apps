<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Run Details Form View -->
    <record id="view_stream_run_details_form" model="ir.ui.view">
        <field name="name">stream.run.details.form</field>
        <field name="model">stream.run.details</field>

        <field name="arch" type="xml">
            <form string="Run Details">

                <sheet>

                    <group string="Run Information">

                        <field name="sale_order_id"/>

                        <field name="stream_run_id"/>
                        <field name="description"/>
                        <field name="group_sequence"/>

                    </group>

                    <group string="Vehicle">

                        <field name="vehicle"/>
                        <field name="vehicle_name"/>
                        <field name="vehicle_type"/>

                    </group>

                    <group string="Driver">

                        <field name="driver"/>
                        <field name="driver_name"/>

                    </group>

                    <group string="Status">

                        <field name="dispatched"/>
                        <field name="departed"/>
                        <field name="completed"/>

                    </group>

                    <group string="Start">

                        <field name="start_actual_datetime"/>
                        <field name="start_planned_datetime"/>
                        <field name="start_postcode"/>

                        <group>
                            <field name="start_lat"/>
                            <field name="start_long"/>
                        </group>

                    </group>

                    <group string="End">

                        <field name="end_actual_datetime"/>
                        <field name="end_planned_datetime"/>
                        <field name="end_postcode"/>

                        <group>
                            <field name="end_lat"/>
                            <field name="end_long"/>
                        </group>

                    </group>

                </sheet>

            </form>
        </field>

    </record>

    <!-- Run Details List View -->
<record id="view_stream_run_details_tree" model="ir.ui.view">
    <field name="name">stream.run.details.tree</field>
    <field name="model">stream.run.details</field>
    <field name="arch" type="xml">
        <list string="Run Details">
    <field name="sale_order_id"/>
    <field name="stream_run_id"/>
    <field name="vehicle_name"/>
    <field name="driver_name"/>
    <field name="group_sequence"/>
    <field name="dispatched"/>
    <field name="departed"/>
    <field name="completed"/>
    <field name="start_planned_datetime"/>
    <field name="end_planned_datetime"/>
</list>
    </field>
</record>
    <record id="action_stream_run_details" model="ir.actions.act_window">

        <field name="name">Run Details</field>
        <field name="res_model">stream.run.details</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>