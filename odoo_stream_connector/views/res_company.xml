<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_company_form_stream" model="ir.ui.view">
        <field name="name">res.company.form.stream</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">

                <page string="Stream Integration">

                    <group>

                        <group string="Credentials">
                             <field name="stream_base_url"/>
                            <field name="stream_client_id"/>

                            <field name="stream_client_secret"
                                   password="True"/>
                                   <field name ="stream_webhook_url"/>


                        </group>

                        <group string="Connection">

                            <field name="stream_connected"
                                   readonly="1"/>

                            <field name="stream_access_token"
                                   readonly="1"
                                   widget="text"/>

                            <field name="stream_token_expiry"
                                   readonly="1"/>

                            <field name="onHandset" widget="boolean_toggle"/>

                        </group>

                    </group>

                    <separator string="Actions"/>

                    <group>

                        <button name="action_stream_authenticate"
                                string="Authenticate"
                                type="object"
                                class="btn-primary"/>

                      

                    </group>
                    <group>

                        <button name="action_stream_fetch_depots"
                                string="Fetch Depots"
                                type="object"
                                class="btn-primary"/>

                    
                        <button name="action_register_webhook" string="Register Webhook" type="object" class="btn-primary"/>
                        <button name="retrive_register_webhook" string="Retrive Webhook" type="object" class="btn-primary"/>

                    </group>

                </page>

            </xpath>

        </field>
    </record>

</odoo>