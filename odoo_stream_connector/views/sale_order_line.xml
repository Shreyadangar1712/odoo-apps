<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_line_form_stream_connector" model="ir.ui.view">
        <field name="name">sale.order.form.stream.connector</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Product Line Fields -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
                   position="after">

                <field name="stream_weight"/>
                <field name="stream_cube"/>
                <field name="stream_stock_location_id"/>
             

            </xpath>

        </field>
    </record>

</odoo>