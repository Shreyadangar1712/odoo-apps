<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_stream_depot_delivery_method_tree" model="ir.ui.view">
        <field name="name">stream.depot.delivery.method.tree</field>
        <field name="model">stream.depot.delivery.method</field>
        <field name="arch" type="xml">
            <list>
                <field name="external_id"/>
                <field name="steam_delivery"/>
                <field name="name"/>
            </list>
        </field>
    </record>


    <!-- Form View -->
    <record id="view_stream_depot_delivery_method_form" model="ir.ui.view">
        <field name="name">stream.depot.delivery.method.form</field>
        <field name="model">stream.depot.delivery.method</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="external_id"/>
                        <field name="steam_delivery"/>
                        <field name="name"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- Action -->
    <record id="action_stream_depot_delivery_method" model="ir.actions.act_window">

        <field name="name">Delivery Methods</field>
        <field name="res_model">stream.depot.delivery.method</field>
        <field name="view_mode">list,form</field>

    </record>


    <!-- Menu -->
    <menuitem
        id="menu_stream_depot_delivery_method"
        name="Delivery Methods"
        parent="menu_stream_menu_root"
        action="action_stream_depot_delivery_method"
        sequence="110"/>

</odoo>