<odoo>
<record id="hr_employee_form_github_inherit" model="ir.ui.view">
    <field name="name">hr.employee.form.github.inherit</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">

        <xpath expr="//field[@name='work_email']" position="after">
            <field name="github_user_name"/>
        </xpath>

    </field>
</record>
</odoo>