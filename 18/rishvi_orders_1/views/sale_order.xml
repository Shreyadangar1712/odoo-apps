        <field name="name">sale.order.form.allow.edit.confirmed.lines</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml"> -->

            <!-- Remove readonly attribute from order lines -->
            <!-- <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">{'': [('state', 'in', ['done', 'cancel'])]}</attribute>
            </xpath>

        </field>
    </record> -->

    <record id="view_order_list_linn_number_linnworks" model="ir.ui.view">
        <field name="name">sale.order.list.linnworks</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="linn_order_number" string="Linnworks Order ID"/>
            </xpath>
        </field>
    </record>
    

</odoo>
