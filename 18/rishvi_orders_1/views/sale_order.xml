<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_linnworks" model="ir.ui.view">
        <field name="name">sale.order.form.linnworks</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_details']" position="inside">
                <!-- <field name="linn_order_number" readonly="1"/> -->
                <field name="linnworks_sync" readonly="1"/>
                <field name="quick_sale"   readonly="state in ['done', 'sale']"  widget="boolean_toggle"/>
            </xpath>
            <!-- Added address page in the notebook-->
              <xpath expr="//page[@name='order_lines']" position="after">
                <page name="address_tab" string="Address">
                    <group>
                        <group string="Billing Address">
                            <field name="partner_invoice_id"
                            context="{'show_address_only': True, 'show_address': True}"
                            options="{'no_create': False}"
                            readonly="state in ['done', 'sale']" />

                            <!-- <field name="partner_invoice_id.street"/>
                            <field name="partner_invoice_id.city"/>
                            <field name="partner_invoice_id.zip"/>
                            <field name="partner_invoice_id.country_id"/> -->
                        </group>
                    <!--Shipping Address-->
                        <group string="Shipping Address">
                            <field name="partner_shipping_id"
                            context="{'show_address_only': True, 'show_address': True}"
                            options="{'no_create': False}"
                            readonly="state in ['done', 'sale']" />
                            <!-- <field name="partner_shipping_id.street"/>
                            <field name="partner_shipping_id.city"/>
                            <field name="partner_shipping_id.zip"/>
                            <field name="partner_shipping_id.country_id"/> -->
                        </group>
                    </group>
                </page>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="LW User Info">
                    <group> 
                        <field name="linnworks_order_id" readonly="1"/> 
                        <field name="linn_order_number" readonly="1"/> 
                    </group>
                </page>
            </xpath>
            <xpath expr="//header/button" position="before">
                <button 
                    name="action_sync_linnworks_order"
                    string="Sync Linnworks Order(RISHVI TO LINN)"
                    type="object"
                    invisible="state not in ['sale', 'cancel']"
                    class="btn-primary"
                    />
            </xpath>


             <!-- <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                 <button 
                    name="check_for_linnwork_quantiy" 
                    string="Update Linn Qty" 
                    type="object"
                    class="oe_link"
                    />
             </xpath> -->
             <xpath expr="//notebook" position="inside">
                <page string="General Info">
                <group>
                   <group string="Source Info">
                       <field name="linn_order_source"  readonly="state in ['done', 'sale']"/>
                       <field name="linn_order_sub_source"  readonly="state in ['done', 'sale']"/>

                   </group>
                    <group string="Status Info">
                        <field name="notes"/>
                    </group>                 
                </group>
                </page>
            </xpath>
            <!--SALE SHIPPING SERVICE PAGE IN THE NOTEBOOK-->
            <xpath expr="//page[@name='order_lines']" position="after">
                <page name="shipping_tab" string="Shipping Service">
                    <group>
                        <group>
                            <field name="shipping_service_id" readonly="state in ['done', 'sale']"/>
                            <field name="service_id"/>
                            <field name="postal_service_name"/>
                            <field name="order_tracking"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="service_country"/>
                            <field name="vendor_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_order_form_inherit_hide_set_to_quotation" model="ir.ui.view">
        <field name="name">sale.order.form.hide.set.to.quotation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Hide the Set to Quotation button -->
            <button name="action_draft" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
        </field>
    </record>
