<?xml version="1.0" encoding="utf-8"?>
<!--rishvi_orders/views/linnworks.xml-->
<odoo>
    <record id="view_linnworks_integration_form_inherit" model="ir.ui.view">
        <field name="name">linn.app.detail.form.inherit</field>
        <field name="model">linn.app.detail</field>
        <field name="inherit_id" ref="rishvi_pos.view_linnworks_config_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <button name="import_orders" string="Import Orders from Linnworks" type="object" class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>