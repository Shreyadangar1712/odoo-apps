<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_source_form" model="ir.ui.view">
        <field name="name">Source</field>
        <field name="model">source.details</field>
        <field name="arch" type="xml">
            <form string="Source">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <record id="view_source_list" model="ir.ui.view">
        <field name="name">Source</field>
        <field name="model">source.details</field>
        <field name="arch" type="xml">
            <list string="Source">
                <field name="name"/>
            </list>
        </field>

    </record>




    <record id="action_source_details" model="ir.actions.act_window">
        <field name="name">Source</field>
        <field name="res_model">source.details</field>
        <field name="view_mode">list,form</field>
        <!--        <field name="view_id" ref="view_teacher_list"/>-->
    </record>


</odoo>