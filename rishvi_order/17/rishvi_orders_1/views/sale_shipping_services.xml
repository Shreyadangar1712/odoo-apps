<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_sale_shipping_services" model="ir.actions.act_window">
        <field name="name">Sale Shipping Services</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.shipping.services</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add an Shipping Services Purpose.
            </p>
        </field>
    </record>

    <record id="view_sale_shipping_services_form" model="ir.ui.view">
        <field name="name">sale.shipping.services.form</field>
        <field name="model">sale.shipping.services</field>
        <field name="arch" type="xml">
            <form string="Sale Shipping Services">
                <sheet>
                    <group>
                        <group>
                            <field name="service_id" readonly="1"/>
                            <field name="postal_service_name"/>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group>
                            <field name="service_country"/>
                            <field name="vendor_id"/>
                            <field name="active" widget="boolean_toggle" options='{"terminology": "active"}'/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sale_shipping_services_tree" model="ir.ui.view">
        <field name="name">sale.shipping.services.tree</field>
        <field name="model">sale.shipping.services</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="service_id" readonly="1"/>
                <field name="postal_service_name"/>
                <field name="service_country"/>
                <field name="vendor_id"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="active" widget="boolean_toggle" options='{"terminology": "active"}'/>
            </list>
        </field>
    </record>


