<templates id="template" xml:space="preserve">
    <t t-name="rishvi_orders.OrderManagementDashboard">
        <div class="o_dashboard container-fluid p-4"
             style="max-height: 100vh; overflow: auto; background: linear-gradient(135deg, #f5f7fa 0%, #e4edf5 100%);">
            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

            <!-- Header Section -->
            <div class="dashboard-header text-center mb-4">
                <div class="header-icon mb-2">
                    <i class="fas fa-file-invoice-dollar fa-3x text-primary"></i>
                </div>
                <h1 class="display-6 fw-bold text-dark mb-1">ORDER MANAGEMENT DASHBOARD</h1>
                <p class="text-muted">Manage and Synchronize Orders between Rishvi and Linnworks</p>
            </div>

            <!-- Single Order Actions -->
            <div class="section-header mb-3">
                <h3 class="fw-semibold text-dark d-flex align-items-center">
                    SINGLE ORDER OPERATIONS
                </h3>
                <div class="section-divider"></div>
            </div>

            <div class="row g-3 mb-4">
                <!-- Import Shipping Services -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card elegant-card h-100 border-0 shadow-sm">
                        <div class="card-header elegant-card-header bg-primary text-white py-2">
                            <span class="fw-bold"> IMPORT SHIPPING SERVICES</span>
                        </div>
                        <div class="card-body text-center d-flex flex-column justify-content-center p-3">
                            <div class="feature-icon mb-2">
                                <i class="fas fa-file-import fa-2x text-primary"></i>
                            </div>
                            <p class="text-muted mb-2 small">Import Shipping Service Data</p>
                            <button class="btn btn-outline-primary w-100 py-2" t-on-click="importData">
                                Import Data
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Search Order by Number -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card elegant-card h-100 border-0 shadow-sm">
                        <div class="card-header elegant-card-header bg-info text-white py-2">
                            <span class="fw-bold">IMPORT BY ORDER NUMBER</span>
                        </div>
                        <div class="card-body p-3">
<!--                            <p class="text-muted mb-2 small">Import orders using order numbers</p>-->
                            <div class="input-group mb-2">
                                <input type="text" id="orderSkuInput" class="form-control" placeholder="e.g. 103444"/>
                            </div>
                            <button class="btn btn-outline-info w-100 py-2" t-on-click="searchOrderBySku">
                                Import Order
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Import Countries -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card elegant-card h-100 border-0 shadow-sm">
                        <div class="card-header elegant-card-header bg-success text-white py-2">
                            <span class="fw-bold">IMPORT COUNTRIES</span>
                        </div>
                        <div class="card-body text-center d-flex flex-column justify-content-center p-3">
                            <p class="text-muted mb-2 small">Import Countries and Taxes</p>
                            <button class="btn btn-outline-success w-100 py-2" t-on-click="importCountries">Import Countries
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bulk Operations + Summary Cards -->
            <div class="section-header mb-3">
                <h3 class="fw-semibold text-dark d-flex align-items-center">
                    <span class="section-icon me-2">
                        <i class="fas fa-layer-group"></i>
                    </span>
                    BULK ORDER OPERATIONS
                </h3>
                <div class="section-divider"></div>
            </div>

            <div class="row g-3 mb-4">

                <!-- Bulk Synchronization -->
                <div class="col-12 col-lg-4">
                    <div class="card elegant-card border-0 shadow-sm compact-card h-100">
                        <div class="card-header elegant-card-header bg-warning text-dark py-2">
                            <i class="fas fa-sync-alt me-2"></i>
                            <span class="fw-bold">BULK ORDER SYNCHRONIZATION</span>
                        </div>
                        <div class="card-body p-4">
                            <div class="row align-items-center mb-2">
                        <!-- Expected Time -->
                        <div class="col-md-4">
                            <h5 class="fw-bold text-dark mb-0">
                                <span class="text-primary"><t t-esc="accpectedTime"/></span>
                                Sec <span class="text-muted small">Expected</span>
                            </h5>
                            <p class="text-muted mb-0 small">
                                <span class="fw-bold"><t t-esc="pagesCount"/></span>
                                Pages Total
                            </p>
                        </div>

                        <!-- Start Page Input -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small mb-1">Start Page</label>
                            <input type="number" min="1" id="startPage" class="form-control form-control-sm" placeholder="Start"/>
                        </div>

                        <!-- End Page Input -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small mb-1">End Page</label>
                            <input type="number" min="1" id="endPage" class="form-control form-control-sm" placeholder="End"/>
                        </div>
                    </div>
                            <br></br>




                            <!-- Progress -->
                            <div class="progress-container mb-2">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted small">Sync Progress</span>
                                    <span class="fw-bold text-primary small"><t t-esc="syncProgress"/>%</span>
                                </div>
                                <div class="progress" style="height: 12px; border-radius: 6px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                                         role="progressbar" t-att-style="'width:' + (syncProgress) + '%;'"></div>
                                </div>
                            </div>
                            <br></br>
                            <br></br>
<!--                            <br></br>-->
<!--                            <br></br>-->

                            <button class="btn btn-outline-primary w-100 py-2" t-on-click="syncAllOrders">
                                <i class="fas fa-sync-alt me-1"></i>
                                Sync All Orders
                            </button>
                        </div>
                    </div>
                </div>
                <!-- Combined Orders Card -->
                <div class="col-12 col-lg-8">
    <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3">

            <div class="row">
                <br></br>
                <!-- Rishvi Orders -->
                <div class="col-12 col-lg-6">
<!--                    <h6 class="fw-bold text-primary mb-1 d-flex align-items-center small">-->
<!--                        <i class="fas fa-store me-1"></i>-->
<!--                        Rishvi Orders-->
<!--                    </h6>-->
                        <div class="card-header elegant-card-header bg-success text-white py-2">
            <h4  class="text-white">
               RISHVI ORDERS
            </h4>
        </div>
                    <br>
                    </br>
                    <br></br>
                    <div class="row g-1 mb-2">
                        <div class="col-6">
                            <div class="stat-card p-1 text-center rounded">
                                <div id="rishvi-draft" class="count fw-bold text-dark small">0</div>
                                <small class="text-muted">Quotation</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card p-1 text-center rounded">
                                <div id="rishvi-confirmed" class="count fw-bold text-dark small">0</div>
                                <small class="text-muted">Sale Order</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card p-1 text-center rounded">
                                <div id="rishvi-cancelled" class="count fw-bold text-dark small">0</div>
                                <small class="text-muted">Cancelled</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card p-1 text-center rounded">
                                <div id="rishvi-synced" class="count fw-bold text-dark small">0</div>
                                <small class="text-muted">Synced</small>
                            </div>
                        </div>
                    </div>

<!--                    <canvas t-ref="rishviPieChart" width="350" height="200" style="max-height:200px;"></canvas>-->
                </div>

                <!-- Linnworks Orders -->
                <div class="col-12 col-lg-6">
<!--                    <h6 class="fw-bold text-info mb-1 d-flex align-items-center small">-->
<!--                        <i class="fas fa-boxes me-1"></i>-->
<!--                        Linnworks Orders-->
<!--                    </h6>-->
                        <div class="card-header elegant-card-header bg-primary text-white py-2">
        <h4 class="text-white" >
          LINNWORKS ORDERS
        </h4>
    </div>

                           <br>
                    </br>
                    <br></br>
                    <div class="row g-1 mb-2">
                        <div class="col-6">
                            <div class="stat-card p-1 text-center rounded">
                                <div id="lineworks-pending" class="count fw-bold text-dark small">0</div>
                                <small class="text-muted">Pending</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card p-1 text-center rounded">
                                <div id="lineworks-processed" class="count fw-bold text-dark small">0</div>
                                <small class="text-muted">Processed</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card p-1 text-center rounded">
                                <div id="lineworks-dispatched" class="count fw-bold text-dark small">0</div>
                                <small class="text-muted">Dispatched</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-card p-1 text-center rounded">
                                <div id="lineworks-returned" class="count fw-bold text-dark small">0</div>
                                <small class="text-muted">Returned</small>
                            </div>
                        </div>
                    </div>

                    <br></br>


<!--                    <canvas t-ref="linnworksPieChart" width="350" height="200" style="max-height:200px;"></canvas>-->
                </div>
            </div>

            <!-- Single Refresh Button -->
            <div class="text-center mt-3">
                <button class="btn btn-outline-primary w-100 py-2" t-on-click="updateOrderStatus">
                    <i class="fas fa-redo-alt me-1"></i>
                    Refresh Orders
                </button>
            </div>
        </div>
    </div>
</div>
            </div>


            <!-- Refresh Button -->


            <!-- System Settings -->
            <div class="section-header mb-3 mt-4">
                <h3 class="fw-semibold text-dark d-flex align-items-center">
                    SYSTEM SETTINGS
                </h3>
                <div class="section-divider"></div>
            </div>

            <div class="row g-3 mb-4">
                <!-- Enable Discounts -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card elegant-card border-0 shadow-sm h-100">
                        <div class="card-header elegant-card-header bg-success text-white py-2">
                            <span class="fw-bold">DISCOUNT MANAGEMENT</span>
                        </div>
                        <div class="card-body text-center p-3">
                            <i class="fas fa-percentage fa-2x text-purple mb-2"></i>
                            <h4 class="fw-bold text-dark small">Activate Discount Functionality For Your Orders</h4>
                            <button class="btn btn-outline-success w-100 py-2" t-on-click="enableDiscount">
                                Enable Discount
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Enable Price Lists -->
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card elegant-card border-0 shadow-sm h-100">
                        <div class="card-header elegant-card-header bg-info text-white py-2">
                            <span class="fw-bold">PRICE LIST MANAGEMENT</span>
                        </div>
                        <div class="card-body text-center p-3">
                            <i class="fas fa-money-bill-wave fa-2x text-indigo mb-2"></i>
                            <h4 class="fw-bold text-dark small">Activate Price List Functionality For Your Products</h4>
                            <button class="btn btn-outline-info w-100 py-2" t-on-click="enablePriceLists">
                                Enable Price Lists
                            </button>
                        </div>
                    </div>
                </div>

                 <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card elegant-card border-0 shadow-sm h-100">
                        <div class="card-header elegant-card-header bg-warning text-white py-2">
                            <span class="fw-bold">SIMILAR CUSTOMERS</span>
                        </div>
                        <div class="card-body text-center p-3">
                            <i class="fas fa-money-bill-wave fa-2x text-indigo mb-2"></i>
                            <h4 class="fw-bold text-dark small">Please press the button below to compare and merge the customers</h4>
                            <button class="btn btn-outline-warning w-100 py-2" t-on-click="compareAndMergeCustomers">
                                Similar Customers
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="dashboard-footer text-center mt-4 pt-3 border-top">
                <p class="text-muted small">Order Management Dashboard</p>
            </div>
        </div>
    </t>
</templates>
