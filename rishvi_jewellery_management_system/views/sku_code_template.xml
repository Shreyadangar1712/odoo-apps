    <!-- Product options: OpenChatter -->
    <template id="product_sku_code" inherit_id="website_sale.product" active="True" name="sku" priority="1">
        <xpath expr="//t[@t-call='website_sale.product_price']" position="after">
        <p t-if="product.sku">
            <table>
            <tr>
                <td style="color:black;font-size:12px;">SKU Code -MEH<span t-esc="product.sku"/></td>
                <td style="color:white;font-size:12px;">SKU - MEH<span t-esc="product.sku"/></td>
                <td style="color:white;font-size:12px;">SKU - MEH<span t-esc="product.sku"/></td>
                <td t-if="product.show_bis" style="color:black;font-size:12px;"><img class="img img-responsive" t-att-src="'/rishvi_jewellery_management_system/static/description/hallmark.png'"/></td>

            </tr>
            </table>
        </p>
        </xpath>
    </template>
    <template id="product_delivery_code" inherit_id="website_sale.product" active="True" name="delivery_code" priority="1">
        <xpath expr="//div[@id='o_product_terms_and_share']" position="after">
        <p>
            <div class="media-body">
                    <input t-set="variable_name" class="residual" type="text" name="area_pincode" id="area_pincode" pattern="\d{6}" maxlength="6" minlength="6" placeholder="Enter Pincode"/>
                    <a role="button" id="check" name="check" href="#" class="btn btn-primary btn_cta">
                            check
                    </a>
                    <p id="message_response" name="message_response" style="font-weight: normal;font-color: #07142A;"></p>
                </div>
        </p>
        </xpath>
    </template>
    <template id="related_product_tag" inherit_id="website_sale.product" active="True" name="related_product" priority="1">
        <xpath expr="//section[@id='product_detail']" position="after">
        <t t-if="product.alternative_product_ids"><h3 class="o_default_snippet_text" style="text-align: center;">
        Explore More Alike&amp;nbsp;<br/></h3>
        </t>
        </xpath>
    </template>
    <template id="hide_login_powered_by_odoo" inherit_id="web.login_layout" name="Hide login Powered by Odoo  ">
        <xpath expr="//div[@class='card-body']//div[last()]" position="replace">
        </xpath>
    </template>
</odoo>