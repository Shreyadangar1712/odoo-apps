<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_countries_form" model="ir.ui.view">
        <field name="name">Countries</field>
        <field name="model">linn.country</field>
        <field name="arch" type="xml">
            <form string="Countries">
                <sheet>
                    <group>
                        <field name="country_name"/>
                        <field name="country_code"/>
                        <field name="currency_ids"/>
                        <field name="country_ids"/>
                        <field name="continent"/>
                        <field name="customs_required"/>
                        <field name="tax_rate"/>
                        <field name="address_format"/>
                        <field name="regions_count"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_countries_list" model="ir.ui.view">
        <field name="name">Countries</field>
        <field name="model">linn.country</field>
        <field name="arch" type="xml">
            <list string="Countries">
                <field name="country_name"/>
                        <field name="country_code"/>
                        <field name="currency_ids"/>
                        <field name="country_ids"/>
                        <field name="continent"/>
                        <field name="customs_required"/>
                        <field name="tax_rate"/>
                        <field name="address_format"/>
                        <field name="regions_count"/>
            </list>
        </field>

    </record>


    <record id="action_linnwork_country" model="ir.actions.act_window">
        <field name="name">LinnWork Countries</field>
        <field name="res_model">linn.country</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>


</odoo>